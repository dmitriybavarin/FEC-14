<controls:StaffHelpWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Mentor"
    Title="{Loc 'fec-xaml-admin-and-mentor-help'}">
    <BoxContainer Orientation="Vertical">
        <RichTextLabel Text="{Loc 'fec-xaml-for-reporting-issues-with-another-player-to-an-a'}" />
        <Button Name="AdminHelpButton" Access="Public" Text="{Loc 'fec-xaml-admin-help'}" StyleClasses="OpenBoth" />
        <RichTextLabel Text="{Loc 'fec-xaml-for-asking-questions-about-the-game'}" Margin="0 20 0 0" />
        <Button Name="MentorHelpButton" Access="Public" Text="{Loc 'fec-xaml-mentor-help'}" StyleClasses="OpenBoth" />
    </BoxContainer>
</controls:StaffHelpWindow>
