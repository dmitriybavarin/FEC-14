<controls:EvacuationComputerWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Marines.Evacuation"
    xmlns:ui="clr-namespace:Content.Client._RMC14.UserInterface"
    Title="{Loc 'fec-xaml-escape-pod-controller'}">
    <BoxContainer Orientation="Vertical">
        <RichTextLabel Text="{Loc 'fec-xaml-bold-information-display-bold'}" />
        <ui:BlueHorizontalSeparator />
        <Label Name="StatusLabel" Access="Public" Text="{Loc 'fec-xaml-escape-pod-status-no-evacuation'}" />
        <Label Name="HatchLabel" Access="Public" Text="{Loc 'fec-xaml-docking-hatch-unsecured'}" />
        <RichTextLabel Text="{Loc 'fec-xaml-bold-pod-controls-bold'}" Margin="0 10 0 0" />
        <ui:BlueHorizontalSeparator />
        <Button Name="DoorButton" Access="Public" Text="{Loc 'fec-xaml-unlock-door'}" StyleClasses="OpenBoth" />
        <Button Name="EjectButton" Access="Public" Text="{Loc 'fec-xaml-manual-eject'}" StyleClasses="OpenBoth" />
        <Button Name="DelayButton" Access="Public" Text="{Loc 'fec-xaml-delay-launch'}" StyleClasses="OpenBoth" />
    </BoxContainer>
</controls:EvacuationComputerWindow>
