<Control xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client._RMC14.Sentry.Laptop"
         xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls">
    <PanelContainer MinHeight="240" Margin="0 0 0 8">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#0A1520"
                                   BorderColor="#4AA3E8" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="10">
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
                <RichTextLabel Name="SentryName" Access="Public"
                             Text="{Loc 'fec-xaml-color-88c7fa-bold-un-571-c-sentry-gun-bold-color'}"
                             VerticalAlignment="Center"
                             HorizontalExpand="True"/>
                <RichTextLabel Name="SentryStatus" Access="Public"
                             Text="{Loc 'fec-xaml-color-229132-online-color'}"
                             VerticalAlignment="Center"
                             Margin="5 0 0 0"/>
            </BoxContainer>

            <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
                <Label Text="{Loc 'fec-xaml-name'}" MinWidth="60" FontColorOverride="#88C7FA" VerticalAlignment="Center"/>
                <LineEdit Name="NameLineEdit" Access="Public"
                         HorizontalExpand="True"
                         Margin="5 0 0 0"
                         PlaceHolder="{Loc 'fec-xaml-enter-custom-name'}"/>
            </BoxContainer>

            <cc:HSeparator Color="#4AA3E8" Margin="0 0 0 8"/>

            <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 5 0">
                    <BoxContainer Orientation="Horizontal" Margin="0 3">
                        <Label Text="{Loc 'fec-xaml-health-2'}" MinWidth="70" FontColorOverride="#88C7FA" VerticalAlignment="Center"/>
                        <ProgressBar Name="HealthBar" Access="Public"
                                   MinSize="160 20"
                                   MaxSize="160 20"
                                   MinValue="0"
                                   MaxValue="1"
                                   Value="1.0"
                                   VerticalAlignment="Center"
                                   HorizontalExpand="True"
                                   Margin="5 0"/>
                        <Label Name="HealthLabel" Access="Public"
                              Text="100/100"
                              MinWidth="60"
                              FontColorOverride="#88C7FA"
                              VerticalAlignment="Center"/>
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" Margin="0 3">
                        <Label Text="{Loc 'fec-xaml-ammo'}" MinWidth="70" FontColorOverride="#88C7FA" VerticalAlignment="Center"/>
                        <ProgressBar Name="AmmoBar" Access="Public"
                                   MinSize="160 20"
                                   MaxSize="160 20"
                                   MinValue="0"
                                   MaxValue="1"
                                   Value="1.0"
                                   VerticalAlignment="Center"
                                   HorizontalExpand="True"
                                   Margin="5 0"/>
                        <Label Name="AmmoLabel" Access="Public"
                              Text="500/500"
                              MinWidth="60"
                              FontColorOverride="#88C7FA"
                              VerticalAlignment="Center"/>
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" Margin="0 3">
                        <Label Text="{Loc 'fec-xaml-mode'}" MinWidth="70" FontColorOverride="#88C7FA" VerticalAlignment="Center"/>
                        <RichTextLabel Name="ModeLabel" Access="Public" Text="{Loc 'fec-xaml-color-229132-active-color'}" VerticalAlignment="Center" Margin="5 0"/>
                    </BoxContainer>
                </BoxContainer>

                <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5 0 0 0">
                    <BoxContainer Orientation="Horizontal" Margin="0 3">
                        <Label Text="{Loc 'fec-xaml-location'}" MinWidth="80" FontColorOverride="#88C7FA" VerticalAlignment="Center"/>
                        <Label Name="LocationLabel" Access="Public" Text="{Loc 'fec-xaml-unknown'}" VerticalAlignment="Center" Margin="5 0"/>
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" Margin="0 3">
                        <Label Text="{Loc 'fec-xaml-target'}" MinWidth="80" FontColorOverride="#88C7FA" VerticalAlignment="Center"/>
                        <RichTextLabel Name="TargetLabel" Access="Public" Text="{Loc 'fec-xaml-color-b0b0b0-none-color'}" VerticalAlignment="Center" Margin="5 0"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>

            <cc:HSeparator Color="#4AA3E8" Margin="0 5"/>

            <BoxContainer Orientation="Vertical" Margin="0 5 0 0">
                <BoxContainer Orientation="Horizontal" Margin="0 0 0 5">
                    <Button Name="IFFExpandButton" Access="Public"
                            Text="►"
                            SetWidth="24"
                            SetHeight="24"
                            VerticalAlignment="Center"/>
                    <Label Text="{Loc 'fec-xaml-iff-targeting-controls'}" FontColorOverride="#88C7FA" VerticalAlignment="Center" Margin="5 0 0 0" HorizontalExpand="True"/>
                    <controls:SentryButton Name="ResetTargetingButton" Access="Public"
                                         BackgroundColor="#1A3D5C"
                                         BorderColor="#88C7FA" BorderThickness="1"
                                         Text="{Loc 'fec-xaml-reset-to-default'}" />
                </BoxContainer>

                <PanelContainer Name="IFFPanel" Access="Public" MinHeight="120" MaxHeight="120" Visible="False">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#050A0F"
                                               BorderColor="#4AA3E8" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                        <GridContainer Name="FactionContainer"
                                       Access="Public"
                                       Columns="3"
                                       Margin="5"
                                       HorizontalExpand="True"/>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <cc:HSeparator Color="#4AA3E8" Margin="0 8 0 8"/>

            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:SentryButton Name="TogglePowerButton" Access="Public"
                                     Margin="0 0 5 0"
                                     BackgroundColor="#1A3D5C"
                                     BorderColor="#88C7FA" BorderThickness="1"
                                     Text="{Loc 'fec-xaml-toggle-power'}" />
                <controls:SentryButton Name="ViewButton" Access="Public"
                                     Margin="0 0 5 0"
                                     BackgroundColor="#1A3D5C"
                                     BorderColor="#88C7FA" BorderThickness="1"
                                     Text="{Loc 'fec-xaml-view-cam'}" />
                <controls:SentryButton Name="UnlinkButton" Access="Public"
                                     BackgroundColor="#5C1A1A"
                                     BorderColor="#A42625" BorderThickness="1"
                                     Text="{Loc 'fec-xaml-unlink'}" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
