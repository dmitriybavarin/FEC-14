<controls:XenoWordQueenWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Xenonids.Word"
    Title="{Loc 'fec-xaml-word-of-the-queen'}"
    MinSize="300 200">
    <BoxContainer Orientation="Vertical">
        <TextEdit Name="Text" Access="Public" HorizontalExpand="True" VerticalExpand="True"/>
        <Button Name="SendButton" Access="Public" MinHeight="35" Text="{Loc 'fec-xaml-send-to-the-hive'}" StyleClasses="OpenBoth" />
    </BoxContainer>
</controls:XenoWordQueenWindow>
