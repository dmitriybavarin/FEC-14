<cc:XenoPickerWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client._RMC14.Xenonids.HiveTeam"
    Title="{Loc 'fec-xaml-select-xenonid'}"
    SetSize="300 400">
    <BoxContainer Orientation="Vertical">
        <LineEdit Name="SearchBar" Access="Public" PlaceHolder="{Loc 'fec-xaml-search'}" />
        <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="Container" Access="Public" Orientation="Vertical" />
        </ScrollContainer>
    </BoxContainer>
</cc:XenoPickerWindow>
