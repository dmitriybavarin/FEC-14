<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="{Loc 'fec-xaml-armor-values'}">
    <BoxContainer Orientation="Vertical" SeparationOverride="4" MinWidth="50" Margin="4">
        <Label Text="{Loc 'fec-xaml-bullet-armor'}" />
        <LineEdit Name="BulletLineEdit" Text="{Loc 'fec-xaml-enter-bullet-armor-value'}" />
        <Label Text="{Loc 'fec-xaml-melee-armor'}" />
        <LineEdit Name="MeleeLineEdit" Text="{Loc 'fec-xaml-enter-melee-armor-value'}" />
        <Label Text="{Loc 'fec-xaml-explosion-armor'}" />
        <LineEdit Name="ExplosionLineEdit" Text="{Loc 'fec-xaml-enter-explosion-armor-value'}" />
        <Label Text="{Loc 'fec-xaml-bio-armor'}" />
        <LineEdit Name="BioLineEdit" Text="{Loc 'fec-xaml-enter-bio-armor-value'}" />
    </BoxContainer>
</DefaultWindow>
