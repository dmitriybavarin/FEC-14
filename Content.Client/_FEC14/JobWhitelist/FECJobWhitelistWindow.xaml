<controls:FECJobWhitelistWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._FEC14.JobWhitelist"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    MinSize="560 480"
    SetSize="680 640"
    Title="{Loc 'fec-job-whitelist-ui-title'}">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="SearchEdit" Access="Public" HorizontalExpand="True" PlaceHolder="{Loc 'fec-job-whitelist-ui-search'}" />
            <OptionButton Name="GroupSelector" Access="Public" MinWidth="160" />
            <Button Name="RefreshButton" Access="Public" Text="{Loc 'fec-job-whitelist-ui-refresh'}" />
        </BoxContainer>
        <Label Name="SummaryLabel" Access="Public" FontColorOverride="#A0A0A0" />
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="Entries" Access="Public" Orientation="Vertical" SeparationOverride="2" />
        </ScrollContainer>
        <cc:HSeparator Color="#4972A1" />
        <Label Text="{Loc 'fec-job-whitelist-ui-add-heading'}" StyleClasses="LabelHeading" />
        <GridContainer Columns="2" HSeparationOverride="8" VSeparationOverride="4">
            <Label Text="{Loc 'fec-job-whitelist-ui-player-label'}" MinWidth="90" />
            <LineEdit Name="PlayerEdit" Access="Public" HorizontalExpand="True" PlaceHolder="{Loc 'fec-job-whitelist-ui-player'}" />
            <Label Text="{Loc 'fec-job-whitelist-ui-job-label'}" MinWidth="90" />
            <OptionButton Name="JobSelector" Access="Public" HorizontalExpand="True" />
            <Label Text="{Loc 'fec-temp-whitelist-duration'}" MinWidth="90" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
                <LineEdit Name="DurationEdit" Access="Public" HorizontalExpand="True" PlaceHolder="{Loc 'fec-temp-whitelist-duration-placeholder'}" ToolTip="{Loc 'fec-temp-whitelist-duration-tooltip'}" />
                <Button Name="AddButton" Access="Public" Text="{Loc 'fec-job-whitelist-ui-add'}" MinWidth="110" />
            </BoxContainer>
        </GridContainer>
        <Label Text="{Loc 'fec-job-whitelist-ui-hint-whitelisted'}" FontColorOverride="#A0A0A0" />
        <Label Text="{Loc 'fec-job-whitelist-ui-hint-other'}" FontColorOverride="#A0A0A0" />
        <Label Name="StatusLabel" Access="Public" FontColorOverride="#C8C864" />
    </BoxContainer>
</controls:FECJobWhitelistWindow>
