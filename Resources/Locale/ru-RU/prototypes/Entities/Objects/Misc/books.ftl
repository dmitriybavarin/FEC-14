    .suffix = { ent-BaseGuidebook.suffix }
ent-BookChemicalCompendium = Химпендиум
    .desc = Исчерпывающее руководство по химическому синтезу, написанное каким-то старым скелетом-профессором.
    .suffix = { ent-BaseGuidebook.suffix }
ent-BookSpaceLaw = Космический закон
    .desc = Свод правил Nanotrasen по поддержанию закона и порядка на ее космических станциях.
    .suffix = { ent-BaseGuidebook.suffix }
