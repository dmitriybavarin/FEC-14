ent-BaseMeleeWeaponEnergy = { ent-BaseItem }
ent-EnergySword = Энергомеч
    .desc = Очень громкий и опасный меч с лучом из чистой концентрированной плазмы. Режет небронированные цели, как масло.
ent-EnergyDaggerLoud = Энергокинжал
    .desc = Не такой громкий и опасный кинжал с лучом из чистой концентрированной плазмы. Этот совсем не замаскирован.
ent-EnergyDagger = Ручка
    .desc = Ручка с темными чернилами.
    .suffix = Энергокинжал
ent-EnergyDaggerBox = Коробка энергокинжала
    .desc = Маленькая коробка с энергокинжалом. При вскрытии упаковка распадается, не оставляя улик.
    .suffix = Энергокинжал
ent-EnergyCutlass = Энергетическая абордажная сабля
    .desc = Экзотическое энергетическое оружие.
ent-EnergySwordDouble = Двойной энергомеч
    .desc = Стажеры командования Синдиката решили, что одного лезвия у энергомеча мало. Помещается в карман.
ent-HyperEutacticBlade = Гиперэвтактический клинок
    .desc = Сверхмассивное оружие, задуманное, чтобы рассечь надвое саму ткань пространства и времени. Гиперэвтактический клинок мгновенно выковывает гиперэвтактическую кристаллическую наноструктуру, проходящую сквозь большинство известных форм материи, как горячий нож сквозь масло.
ent-CyborgEnergySwordDouble = { ent-EnergySwordDouble }
    .desc = Стажеры командования Синдиката решили, что одного лезвия у энергомеча мало. Специально для киборгов Синдиката.
    .suffix = Одноручный, для боргов
ent-EnergyDaggerLoudBlue = { ent-EnergyDaggerLoud }
    .desc = { ent-EnergyDaggerLoud.desc }
    .suffix = Синий
