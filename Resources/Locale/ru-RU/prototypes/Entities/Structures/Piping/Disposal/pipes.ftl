ent-DisposalJunctionFlipped = { ent-DisposalJunction }
    .desc = Трехсторонняя развилка. Стрелка показывает, куда выходят предметы.
    .suffix = перевернутые
ent-DisposalYJunction = Y-развилка утилизации
