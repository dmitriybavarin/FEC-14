ent-RMCAntiAirProp = Пушка IX-50 MGAD
    .desc = IX-50: новейшая система противовоздушной и микрогравитационной обороны, способная самостоятельно отслеживать и уничтожать угрозы прикрепленными ракетами.
    .suffix = Реквизит
ent-RMCAntiAirPropFlipped = { ent-RMCAntiAirProp }
    .desc = { ent-RMCAntiAirProp.desc }
    .suffix = Декорация, отражена
ent-RMCRailgunProp = Планетарная батарея MAC "БЕРСТ"
    .desc = Планетарная батарея MAC "БЕРСТ": продвинутая магнитная пушка-ускоритель масс, которая длинной линейной системой магнитных катушек разгоняет металлические снаряды до невероятных скоростей.
    .suffix = { ent-RMCAntiAirProp.suffix }
ent-RMCRailgunPropFlipped = { ent-RMCRailgunProp }
    .desc = { ent-RMCRailgunProp.desc }
    .suffix = Декорация, отражена
ent-RMCMissileTubeProp = Пусковая система ПСО Mk 33
    .desc = Пусковые трубы холодного старта, из которых можно запускать несколько видов ракет. Чаще всего это противоспутниковая ASAT-21 "Рапира IV" против спутников и прочих космических аппаратов и BGM-227 "Кувалда" для ударов по земле.
    .suffix = Реквизит
ent-RMCMissileTubePropFlipped = { ent-RMCMissileTubeProp }
    .desc = { ent-RMCMissileTubeProp.desc }
    .suffix = Декорация, отражена
