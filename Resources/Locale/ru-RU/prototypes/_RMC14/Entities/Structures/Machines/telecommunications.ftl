    .suffix = DrawDepth
ent-RMCTelecomRelay = Ретранслятор связи
    .desc = Мощное оборудование для передачи огромных объемов данных на большие расстояния.
ent-RMCTelecomRelayDD = { ent-RMCTelecomRelay }
    .desc = { ent-RMCTelecomRelay.desc }
    .suffix = DrawDepth
ent-RMCTelecomProcessorUnit = Процессорный блок
    .desc = Машина для обработки больших объемов информации.
ent-RMCTelecomProcessorUnitDD = { ent-RMCTelecomProcessorUnit }
