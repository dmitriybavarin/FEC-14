ent-RMCGunRackM54CEmpty = Оружейная стойка M54C
    .desc = Оружейная стойка производства AEGIS для длинноствольного оружия. Изначальная модель задумывалась легко перестраиваемой, но КМП США заказал стойки с фиксированными гнездами, в которые помещаются только винтовки M54C. Одни говорят, что так дешевле, другие, что главная причина в умении морпехов сломать все, что сложнее вольфрамового шарика.
    .suffix = M54C, пустой
ent-RMCGunRackM54CFilled = { ent-RMCGunRackM54CEmpty }
    .desc = { ent-RMCGunRackM54CEmpty.desc }
    .suffix = M54C, заполненный
