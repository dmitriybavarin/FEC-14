ent-RMCAutodoc = Автодок, экстренная медицинская система
    .desc = Экстренное хирургическое устройство, которое само проводит спасительное лечение и простые операции без участия хирурга.
    .suffix = Появляется с консолью
ent-RMCAutodocNoConsole = { ent-RMCAutodoc }
    .desc = { ent-RMCAutodoc.desc }
    .suffix = Без консоли
ent-RMCAutodocConsole = Консоль управления автодоком
    .desc = Интерфейс управления соседним автодоком. Для правильной работы нужна подготовка.
ent-RMCAutodocUnskilled = Продвинутый автодок, экстренная медицинская система
    .desc = Куда более дорогая модель автодока с диагностическим модулем ИИ. В итоге интерфейс стал гораздо проще: наведи и нажми, справится кто угодно, даже без подготовки.
    .suffix = Без навыков, улучшенный
ent-RMCAutodocConsoleUpgraded = Улучшенная консоль автодока
    .desc = { ent-RMCAutodocConsole.desc }
