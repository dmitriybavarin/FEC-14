ent-RMCGunRackM34IncineratorEmpty = Стойка огнеметов M34
    .desc = Оружейная стойка производства AEGIS для длинноствольного оружия. Изначальная модель задумывалась легко перестраиваемой, но КМП США заказал стойки с фиксированными гнездами, в которые помещаются только огнеметы M34. Одни говорят, что так дешевле, другие, что главная причина в умении морпехов сломать все, что сложнее вольфрамового шарика.
    .suffix = Огнемет M34, пустой
ent-RMCGunRackM34IncineratorFilled = { ent-RMCGunRackM34IncineratorEmpty }
    .desc = { ent-RMCGunRackM34IncineratorEmpty.desc }
    .suffix = Огнемет M34, заполненный
