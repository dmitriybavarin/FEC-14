ent-RMCGunRackM42A2Empty = Оружейная стойка M42A2
    .desc = Оружейная стойка производства AEGIS для длинноствольного оружия. Изначальная модель задумывалась легко перестраиваемой, но КМП США заказал стойки с фиксированными гнездами, в которые помещаются только дробовики M42A2. Одни говорят, что так дешевле, другие, что главная причина в умении морпехов сломать все, что сложнее вольфрамового шарика.
    .suffix = M42A2, пустой
ent-RMCGunRackM42A2Filled = { ent-RMCGunRackM42A2Empty }
    .desc = { ent-RMCGunRackM42A2Empty.desc }
    .suffix = M42A2, заполненный
ent-RMCGunRackType23Empty = Оружейная стойка Type 23
    .desc = Какая-то оружейная стойка без бренда. По уставам SOF и SPPA оружие положено хранить в надежных сейфах и выдавать только по необходимости. Разумеется, большинство (но не все!) подразделений на это закрывают глаза и убирают оружие в сейфы, только когда нагрянет проверка.
    .suffix = Type 23, пустой
ent-RMCGunRackType23Filled = { ent-RMCGunRackType23Empty }
    .desc = { ent-RMCGunRackType23Empty.desc }
    .suffix = Type 23, заполненный
