ent-CMFence = Забор
    .desc = Большая металлическая сетка, натянутая между двумя столбами. Дешевый способ разделить участки, сквозь который все видно.
ent-RMCFenceBroken = Сломанный забор
    .desc = Месиво из порванной проволоки между двумя столбами. Уже никому не мешает пройти.
ent-RMCFenceHybrisa = { ent-CMFence }
    .desc = { ent-CMFence.desc }
ent-RMCFenceHybrisaBroken = { ent-RMCFenceBroken }
    .desc = { ent-RMCFenceBroken.desc }
ent-RMCFenceHybrisaElectric = { ent-CMFence }
    .desc = { ent-CMFence.desc }
    .suffix = Под током
ent-RMCFenceHybrisaElectricBroken = { ent-RMCFenceBroken }
    .desc = { ent-RMCFenceBroken.desc }
    .suffix = Под током
ent-RMCFenceOvergrown = Заросший забор
    .desc = Большая металлическая сетка между двумя столбами, оплетенная лозами и ползучими побегами. Участки все еще разделяет, но природа берет свое.
ent-RMCFenceOvergrownBroken = Сломанный заросший забор
    .desc = Месиво из порванной проволоки и ползучих сорняков между двумя столбами, поглощенное годами буйного роста.
ent-RMCFenceSPP = { ent-CMFence }
    .desc = { ent-CMFence.desc }
    .suffix = SPP
ent-RMCFenceSPPBroken = { ent-RMCFenceBroken }
    .desc = { ent-RMCFenceBroken.desc }
    .suffix = SPP
