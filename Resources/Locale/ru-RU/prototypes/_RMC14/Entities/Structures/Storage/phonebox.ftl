ent-RMCPhoneboxOn = { ent-RMCPhoneboxBase }
    .desc = { ent-RMCPhoneboxBase.desc }
    .suffix = Включен
ent-RMCPhoneboxBroken = { ent-RMCPhoneboxBrokenBase }
