    .desc = { ent-RMCPressurizedCanister.desc }
    .suffix = Трикордразин
ent-RMCPressurizedCanisterMeraBic = { ent-RMCPressurizedCanister }
    .desc = { ent-RMCPressurizedCanister.desc }
    .suffix = Мерабик
ent-RMCPressurizedCanisterKeloDerm = { ent-RMCPressurizedCanister }
