ent-RMCBaseTesla = { ent-BaseItem }
ent-RMCTesla = Катушка Теслы UN 21S
    .desc = Совершенный способ получать электричество высокого напряжения, малого тока и высокой частоты. Небольшие доработки позволяют бить сокрушительным разрядом только по враждебным целям.
ent-RMCTeslaMicro = Микрокатушка Теслы UN 25S
    .desc = Совершенный способ получать электричество высокого напряжения, малого тока и высокой частоты. Небольшие доработки позволяют бить сокрушительным разрядом только по враждебным целям. Эта меньше и легче.
ent-RMCTeslaOverclocked = Разогнанная катушка Теслы UN 21S
    .desc = Совершенный способ получать электричество высокого напряжения, малого тока и высокой частоты. Небольшие доработки позволяют бить сокрушительным разрядом только по враждебным целям. Эта сильно разогнана: напряжение намного выше, но бьет она медленнее.
ent-RMCTeslaTSE = Катушка Теслы L10D
    .desc = { ent-RMCTesla.desc }
    .suffix = PVE, "свой-чужой" RCM
