ent-RMCArmbandBase = Нарукавная повязка
    .desc = Абстрактная нарукавная повязка.
ent-RMCAlphaArmband = Повязка Альфы
    .desc = Повязка в цветах отделения, чтобы своих было легче узнать.
ent-RMCBravoArmband = Повязка Браво
    .desc = { ent-RMCAlphaArmband.desc }
