    [few] {$count} человека
    *[other] {$count} человек
}
rev-headrev-name = [color=#5e9cff]{$name}[/color]: обращено {$count ->
    [one] {$count} человек
    [few] {$count} человека
    *[other] {$count} человек
}
rev-deconverted-title = Вы освобождены!
