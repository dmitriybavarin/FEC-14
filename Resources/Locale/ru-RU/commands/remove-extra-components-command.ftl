cmd-removeextracomponents-desc = Удаляет у всех сущностей с указанным id компоненты, которых нет в их прототипе.\nЕсли id не указан, подходят все сущности.
cmd-removeextracomponents-help = removeextracomponents / removeextracomponents <entityId>
cmd-removeextracomponents-invalid-prototype-id = Не найден прототип сущности с id {$id}.
cmd-removeextracomponents-success = Удалено компонентов: {$count}, у сущностей: {$entities},
cmd-removeextracomponents-success-with-id = Удалено компонентов: {$count}, у сущностей: {$entities} с id {$id}.
