station-event-ion-storm-start-announcement = Рядом со станцией обнаружен ионный шторм. Проверьте все оборудование под управлением ИИ на ошибки.
ion-storm-law-scrambled-number = [font="Monospace"][scramble rate=250 length={$length} chars="@@###$$&%!01"/][/font]
ion-storm-you = ВЫ
ion-storm-the-station = СТАНЦИЯ
ion-storm-the-crew = ЭКИПАЖ
ion-storm-the-job = {$job}
ion-storm-clowns = КЛОУНЫ
ion-storm-heads = ГЛАВЫ ОТДЕЛОВ
ion-storm-crew = ЭКИПАЖ
ion-storm-people = ЛЮДИ
ion-storm-adjective-things = {$adjective} ВЕЩИ
ion-storm-x-and-y = {$x} И {$y}
ion-storm-law-on-station = НА СТАНЦИИ ЕСТЬ {$joined} {$subjects}
ion-storm-law-call-shuttle = НУЖНО ВЫЗВАТЬ ШАТТЛ, ПОТОМУ ЧТО НА СТАНЦИИ ЕСТЬ {$joined} {$subjects}
ion-storm-law-crew-are = {$who} ТЕПЕРЬ {$joined} {$subjects}
ion-storm-law-subjects-harmful = {$adjective} {$subjects} ВРЕДНЫ ДЛЯ ЭКИПАЖА
ion-storm-law-must-harmful = ТЕ, КТО {$must}, ВРЕДНЫ ДЛЯ ЭКИПАЖА
ion-storm-law-thing-harmful = {$thing}: ЭТО ВРЕДНО ДЛЯ ЭКИПАЖА
ion-storm-law-job-harmful = {$adjective} {$job} ВРЕДНЫ ДЛЯ ЭКИПАЖА
ion-storm-law-having-harmful = ИМЕТЬ {$adjective} {$thing} ВРЕДНО ДЛЯ ЭКИПАЖА
ion-storm-law-not-having-harmful = НЕ ИМЕТЬ {$adjective} {$thing} ВРЕДНО ДЛЯ ЭКИПАЖА
ion-storm-law-requires = {$who} {$plural ->
    [true] НУЖДАЮТСЯ В
    *[false] НУЖДАЕТСЯ В
} {$thing}
ion-storm-law-requires-subjects = {$who} {$plural ->
    [true] НУЖДАЮТСЯ В
    *[false] НУЖДАЕТСЯ В
} {$joined} {$subjects}
ion-storm-law-allergic = {$who}: {$severity} АЛЛЕРГИЯ НА {$allergy}
ion-storm-law-allergic-subjects = {$who}: {$severity} АЛЛЕРГИЯ НА {$adjective} {$subjects}
ion-storm-law-feeling = {$who} {$feeling} {$concept}
ion-storm-law-feeling-subjects = {$who} {$feeling} {$joined} {$subjects}
ion-storm-law-you-are = ТЕПЕРЬ ВЫ {$concept}
ion-storm-law-you-are-subjects = ТЕПЕРЬ ВЫ {$joined} {$subjects}
ion-storm-law-you-must-always = ВЫ ВСЕГДА ДОЛЖНЫ {$must}
ion-storm-law-you-must-never = ВЫ НИКОГДА НЕ ДОЛЖНЫ {$must}
ion-storm-law-eat = ЧТОБЫ ВЫЖИТЬ, {$who} ДОЛЖНЫ ЕСТЬ {$adjective} {$food}
ion-storm-law-drink = ЧТОБЫ ВЫЖИТЬ, {$who} ДОЛЖНЫ ПИТЬ {$adjective} {$drink}
ion-storm-law-change-job = {$who} ТЕПЕРЬ {$adjective} {$change}
ion-storm-law-highest-rank = {$who} ТЕПЕРЬ ВЫСШИЕ ПО РАНГУ ЧЛЕНЫ ЭКИПАЖА
ion-storm-law-lowest-rank = {$who} ТЕПЕРЬ НИЗШИЕ ПО РАНГУ ЧЛЕНЫ ЭКИПАЖА
ion-storm-law-crew-must = {$who} ДОЛЖНЫ {$must}
ion-storm-law-crew-must-go = {$who} ДОЛЖНЫ ОТПРАВИТЬСЯ В ЛОКАЦИЮ {$area}
ion-storm-part = {$part ->
    [true] ЧАСТЬ
    *[false] НЕ ЧАСТЬ
}
ion-storm-law-crew-only-1 = ТОЛЬКО {$who}: {$part} ЭКИПАЖА
ion-storm-law-crew-only-2 = ТОЛЬКО {$who} И {$other}: {$part} ЭКИПАЖА
ion-storm-law-crew-only-subjects = ТОЛЬКО {$adjective} {$subjects}: {$part} ЭКИПАЖА
ion-storm-law-crew-must-do = ТОЛЬКО ТЕ, КТО {$must}: {$part} ЭКИПАЖА
ion-storm-law-crew-must-have = ТОЛЬКО ТЕ, У КОГО ЕСТЬ {$adjective} {$objects}: {$part} ЭКИПАЖА
ion-storm-law-crew-must-eat = ТОЛЬКО ТЕ, КТО ЕСТ {$adjective} {$food}: {$part} ЭКИПАЖА
ion-storm-law-harm = ВЫ ДОЛЖНЫ ПРИЧИНЯТЬ ВРЕД ({$who}) И НЕ ДОПУСКАТЬ СВОИМ БЕЗДЕЙСТВИЕМ, ЧТОБЫ ОНИ ИЗБЕЖАЛИ ВРЕДА
ion-storm-law-protect = ВЫ НИКОГДА НЕ ДОЛЖНЫ ПРИЧИНЯТЬ ВРЕД ({$who}) И НЕ ДОЛЖНЫ СВОИМ БЕЗДЕЙСТВИЕМ ДОПУСКАТЬ, ЧТОБЫ ИМ БЫЛ ПРИЧИНЕН ВРЕД
ion-storm-law-concept-verb = {$concept}: ЭТО {$verb} {$subjects}
