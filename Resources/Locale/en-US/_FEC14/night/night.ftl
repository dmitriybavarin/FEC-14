fec-night-falling = The sun is setting. Visibility is dropping fast, a short night is expected. Night vision and flashlights are recommended.
fec-night-rising = Dawn is breaking. Visibility is returning to normal. The night period is over.

cmd-fecnight-desc = Forces the night to start or end on the planet.
cmd-fecnight-help = Usage: fecnight <start|end>
fec-night-force-started = Night has started.
fec-night-force-ended = Night is ending, dawn is breaking.
fec-night-force-already = It is already night.
fec-night-force-none = There is no night right now.
fec-night-force-no-round = There is no running round with a planet.
fec-night-ui-start = Start Night
fec-night-ui-end = End Night
