        },
        {
            "label": "FEC: Проверка безопасности (код, текстуры, аудио)",
            "type": "process",
            "command": "${workspaceFolder}/../.INSTRUCTIONS/I-FEC14/tools/.venv/Scripts/python.exe",
            "args": ["${workspaceFolder}/../.INSTRUCTIONS/I-FEC14/tools/sec/scan_all.py", "--changed", "upstream/master"],
            "options": {"env": {"PYTHONIOENCODING": "utf-8", "FEC14_REPO": "${workspaceFolder}"}},
            "problemMatcher": [],
            "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
        },
        {
            "label": "FEC: Обновить сабмодули (RUN_THIS.py)",
