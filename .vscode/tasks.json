{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "hide": true,
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "/property:GenerateFullPaths=true", // Ask dotnet build to generate full paths for file names.
                "/consoleloggerparameters:'ForceNoAlign;NoSummary'" // Do not generate summary otherwise it leads to duplicate errors in Problems panel
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-yaml-linter",
            "hide": true,
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Content.YAMLLinter/Content.YAMLLinter.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:'ForceNoAlign;NoSummary'"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "hide": true,
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--no-build",
                "--configuration",
                "DebugOpt",
                "Content.Tests/Content.Tests.csproj",
                "--",
                "NUnit.ConsoleOut=0"
            ],
            "group": {
                "kind": "test"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "integration-test",
            "hide": true,
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--no-build",
                "--configuration",
                "DebugOpt",
                "Content.IntegrationTests/Content.IntegrationTests.csproj",
                "--",
                "NUnit.ConsoleOut=0",
                "NUnit.MapWarningTo=Failed.ConsoleOut=0",
                "NUnit.MapWarningTo=Failed"
            ],
            "group": {
                "kind": "test"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "FEC: Собрать и запустить сервер + клиент (DEV)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "FEC: Собрать всё (DEV)",
                "FEC: _сервер и клиент без сборки (DEV)"
            ],
            "problemMatcher": []
        },
        {
            "label": "FEC: Собрать всё (DEV)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "SpaceStation14.sln",
                "--configuration",
                "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:ForceNoAlign;NoSummary",
                "/m"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "FEC: Запустить сервер (DEV)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "Content.Server",
                "--configuration",
                "Debug",
                "--",
                "--config-file",
                "${workspaceFolder}/.CONFIG/server_config.toml"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "FEC: Запустить клиент (DEV)",
