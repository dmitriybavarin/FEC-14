{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "hide": true,
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:'ForceNoAlign;NoSummary'"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-yaml-linter",
            "hide": true,
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Content.YAMLLinter/Content.YAMLLinter.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:'ForceNoAlign;NoSummary'"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "FEC: Собрать DEV",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "SpaceStation14.sln",
                "--configuration",
                "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:ForceNoAlign;NoSummary",
                "/m"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "FEC: Собрать Release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "SpaceStation14.sln",
                "--configuration",
                "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:ForceNoAlign;NoSummary",
                "/m"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "FEC: _сервер (DEV)",
            "hide": true,
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "Content.Server",
                "--configuration",
                "Debug",
                "--no-build",
                "--",
                "--config-file",
                "${workspaceFolder}/.CONFIG/server_config.toml"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "FEC: _клиент (DEV)",
            "hide": true,
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "Content.Client",
                "--configuration",
                "Debug",
                "--no-build"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "FEC: _сервер (Release)",
            "hide": true,
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "Content.Server",
                "--configuration",
                "Release",
                "--no-build",
                "--",
                "--config-file",
                "${workspaceFolder}/.CONFIG/server_config.toml"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "FEC: _клиент (Release)",
            "hide": true,
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "Content.Client",
                "--configuration",
                "Release",
                "--no-build"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "FEC: Запустить DEV (сервер + клиент)",
            "dependsOn": [
                "FEC: _сервер (DEV)",
                "FEC: _клиент (DEV)"
            ],
            "problemMatcher": []
        },
        {
            "label": "FEC: Запустить Release (сервер + клиент)",
            "dependsOn": [
                "FEC: _сервер (Release)",
                "FEC: _клиент (Release)"
            ],
            "problemMatcher": []
        },
        {
            "label": "FEC: Пустой .CONFIG + проверки",
            "type": "process",
            "command": "python",
            "args": [
                "Tools/_FEC14/init_cfg.py",
                "--reset",
                "--check"
            ],
            "options": {
                "env": {
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "FEC: Запустить Discord-бота",
            "type": "process",
            "command": "${workspaceFolder}/Tools/_FEC14/Bot/run.bat",
            "options": {
                "cwd": "${workspaceFolder}/Tools/_FEC14/Bot"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
